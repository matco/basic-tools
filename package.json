{
	"name": "@matco/basic-tools",
	"description": "basic-tools is a set of tools that will make your life easier when developing Javascript applications",
	"version": "2.4.4",
	"scripts": {
		"lint": "eslint .",
		"tsc": "tsc",
		"types": "tsc -p tsconfig.types.json",
		"test": "mocha",
		"test-server": "http-server .",
		"prepublishOnly": "npm run types"
	},
	"type": "module",
	"files": [
		"*.js",
		"*.d.ts",
		"!eslint.config.js",
		"!driver.js"
	],
	"types": "./extension.d.ts",
	"exports": {
		"./bus.js": {
			"types": "./bus.d.ts",
			"import": "./bus.js"
		},
		"./csv.js": {
			"types": "./csv.d.ts",
			"import": "./csv.js"
		},
		"./db_connector.js": {
			"types": "./db_connector.d.ts",
			"import": "./db_connector.js"
		},
		"./dom_extension.js": {
			"types": "./dom_extension.d.ts",
			"import": "./dom_extension.js"
		},
		"./extension.js": {
			"types": "./extension.d.ts",
			"import": "./extension.js"
		},
		"./hash.js": {
			"types": "./hash.d.ts",
			"import": "./hash.js"
		},
		"./loader.js": {
			"types": "./loader.d.ts",
			"import": "./loader.js"
		},
		"./lzw.js": {
			"types": "./lzw.d.ts",
			"import": "./lzw.js"
		},
		"./queue.js": {
			"types": "./queue.d.ts",
			"import": "./queue.js"
		},
		"./reviver.js": {
			"types": "./reviver.d.ts",
			"import": "./reviver.js"
		},
		"./svg.js": {
			"types": "./svg.d.ts",
			"import": "./svg.js"
		},
		"./timeframe.js": {
			"types": "./timeframe.d.ts",
			"import": "./timeframe.js"
		},
		"./uuid.js": {
			"types": "./uuid.d.ts",
			"import": "./uuid.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [],
	"author": {
		"name": "Matthieu Corageoud",
		"email": "matthieu.corageoud@gmail.com"
	},
	"license": "Unlicense",
	"repository": {
		"type": "git",
		"url": "https://github.com/matco/basic-tools.git"
	},
	"bugs": {
		"url": "https://github.com/matco/basic-tools/issues"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^26.4.1",
		"eslint": "^10.10.0",
		"eslint-plugin-jsdoc": "^64.3.6",
		"globals": "^17.12.0",
		"http-server": "^14.1.1",
		"mocha": "^12.0.0",
		"typescript": "^7.0.2"
	}
}
