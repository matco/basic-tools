{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"alwaysStrict": true,
		"checkJs": true,
		"declaration": false,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"ESNext",
			/*"WebWorker", do not include web workers because it conflicts with ESNext*/
			"DOM"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": false,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"sourceMap": true,
		//"strict" is not enabled because "noImplicitAny" would flag the untyped prototype extensions in extension.js and dom_extension.js
		//instead, all the individual strict flags are enabled manually, except "noImplicitAny"
		"strict": false,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"strictPropertyInitialization": true,
		"target": "ESNext",
		"types": [
			"node",
			"mocha"
		]
	},
	"exclude": [
		"node_modules",
		"eslint.config.js"
	]
}
